{
  "name": "ris-platform",
  "version": "1.0.0",
  "description": "RIS (Rapha Integrated Solutions) Invoice Discounting & Early Payment Platform — Uganda",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts && eslint tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --config jest.integration.config.ts --runInBand --forceExit --detectOpenHandles",
    "test:all": "jest --config jest.all.config.ts --runInBand --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "db:migrate": "ts-node src/shared/database/migrations/run.ts",
    "db:seed": "ts-node src/shared/database/seeds/dev-seed.ts",
    "simulate:happy-path": "ts-node --transpile-only scripts/simulate-happy-path.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "africastalking": "^0.7.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.12.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/africastalking": "^0.6.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.10.9",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "africastalking": {
      "axios": "^1.7.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
