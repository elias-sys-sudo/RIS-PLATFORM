# =============================================================================
# RIS Platform — Environment Variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL 15) ---
DATABASE_URL=postgresql://ris_user:ris_dev_password@localhost:5432/ris_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# JWT_SECRET must be minimum 256 bits (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_hex_char_secret_here_generate_with_crypto_randombytes_32
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Encryption ---
# AES-256 key must be exactly 64 hex characters (256 bits)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_char_encryption_key_here_generate_with_crypto_randombytes_32

# --- EFT / RTGS ---
# EFT_BANK_API_URL + EFT_BANK_API_KEY + EFT_OUTPUT_DIR are REQUIRED in production
# (sandbox/dev fall back to MockProvider so any value is fine).
EFT_BANK_API_URL=https://sandbox.bank.example.ug/eft/v1
EFT_BANK_API_KEY=sandbox_eft_api_key_here
EFT_OUTPUT_DIR=./eft-output
EFT_BANK_CODE=RIS001

# --- Email (AWS SES via SMTP / nodemailer) ---
# SMTP credentials — works with any transactional email provider. RIS
# currently uses Resend (smtp.resend.com:465, user=resend, pass=<re_xxx>).
# Switching providers is a config-only change: update these four values and
# the SES_FROM_* aliases below. The env var prefix says SES_ for historical
# reasons; the values are plain SMTP credentials and provider-agnostic.
# See deploy/email-setup-runbook.md for full setup.
SES_SMTP_HOST=smtp.resend.com
SES_SMTP_PORT=465
SES_SMTP_USER=resend
SES_SMTP_PASS=re_your_resend_api_key_here

# Operator attestation: set to "true" ONLY after the transactional email
# provider is production-ready — domain verified, out of sandbox / development
# mode, DKIM aligned, smoke-tested to a real inbox.
#
# In NODE_ENV=production or NODE_ENV=staging the server refuses to start
# unless this is "true". This gate exists because sandbox-mode providers
# (AWS SES default, Postmark pending review, SendGrid trial) silently reject
# delivery to any non-allowlisted recipient, which would leave new suppliers
# stuck at the "Please verify your email" screen with no operator-visible
# failure signal.
EMAIL_PROVIDER_VERIFIED=false

# Optional tuning (defaults shown):
# SES_SMTP_RATE_LIMIT=12          # messages/sec — keep below provider cap
# SES_SMTP_MAX_CONNECTIONS=5      # connection pool size

# From-address routing — each template type goes out under a different sender
# alias. Each alias must be (a) a verified SES identity AND (b) a GoDaddy
# forwarding alias so replies land somewhere readable. See
# deploy/email-setup-runbook.md for the full setup.
SES_FROM_DEFAULT=noreply@raphaintegrated.com
SES_FROM_CONFIRM=confirm@raphaintegrated.com
SES_FROM_PAYMENTS=payments@raphaintegrated.com
SES_FROM_KYC=kyc@raphaintegrated.com
SES_FROM_COLLECTIONS=collections@raphaintegrated.com
SES_FROM_SUPPORT=support@raphaintegrated.com

# Legacy SendGrid vars — kept for rollback only, no longer read by code.
# Remove after one clean SES deploy cycle.
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=payments@ris.co.ug
EMAIL_FROM="RIS Platform <noreply@raphaintegrated.com>"

# --- SMS (Africa's Talking) ---
AT_API_KEY=your_africas_talking_api_key_here
AT_USERNAME=ris-sandbox
AT_SENDER_ID=RIS

# --- Frontend ---
FRONTEND_URL=https://app.ris.ug

# --- Business Rules ---
MAX_INVOICE_TENOR_DAYS=90
MIN_INVOICE_TENOR_DAYS=7
AML_FLAG_THRESHOLD_UGX=100000000
DUAL_AUTH_REQUIRED=true

# --- Rate Limiting ---
# Auth limit applies ONLY to credential-presenting endpoints (POST /auth/login,
# POST /auth/2fa/verify) and only counts FAILED attempts (skipSuccessfulRequests).
# Production: 10 / 15-min. Staging/UAT: 30 / 15-min.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
